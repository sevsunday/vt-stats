/statsgate

# Node tooling used by scripts/verify_proto_decode.mjs + pbjs descriptor regen.
# Runtime dashboard uses only vendored code under vendor/ — node_modules is
# strictly local dev-tooling for schema migrations.
node_modules/
package.json
package-lock.json

# Python bytecode cache.
__pycache__/
*.pyc
*.pyo

# Research workspace. Scripts are promoted to scripts/ when ready;
# outputs are regenerable via scripts/audit_sentinel_events.mjs etc.
/_investigation/

# VTSR-T predictive validator output (scripts/validate_elo.py).
# Phase 1 smoke-test artifacts: report.md, report.json, bootstrap.json.
# Regenerable from any pipeline run; not part of the dashboard contract.
/_validation/

# Object-render assets too large for the GitHub Pages 1 GB site limit: the
# high-quality native .dds texture set (~885 MB) and the multi-angle static
# gallery (~578 MB). The browser doesn't load shots/ at all, and HQ degrades to
# the perf PNG set. Both are regenerated locally by scripts/convert_msh.py and
# could be moved to an external host later. Only geometry/ + textures/perf/ +
# thumbnails/ + index.json are published.
# /data/models/textures/hq/
# /data/models/shots/

# Scratch commit message files used to pipe HEREDOC-style messages into
# git commit (PowerShell doesn't support heredoc). Always transient.
_commit_msg.txt
/_sniper_investigation
/odf-parser-seed

# Scoped ignores for the _map-analysis/ workspace live in
# _map-analysis/.gitignore (third-party data, generated artifacts, logs).
/drand-client-master
/statsgate-dev
/f9bomber
